{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2024", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
