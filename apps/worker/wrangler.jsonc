{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kuyara-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // One Durable Object per daily counter name (AI probe, AI recommend budget, the two
  // capped weather providers); SQLite-backed is the Workers Free option. Migrations are
  // top-level and apply to every environment.
  "durable_objects": {
    "bindings": [{ "name": "DAILY_COUNTERS", "class_name": "DailyCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyCounter"] }],
  "ratelimits": [
    { "name": "AI_PROBE_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "AI_RECOMMEND_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "WEATHER_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "OPENROUTER_MODELS": ["nex-agi/nex-n2.5-mini:free", "nvidia/nemotron-3-super-120b-a12b:free", "nex-agi/nex-n2.5-pro:free"],
    "WORKERS_AI_MODELS": ["@cf/meta/llama-3.3-70b-instruct-fp8-fast", "@cf/mistralai/mistral-small-3.1-24b-instruct"]
  },
  // The local end-to-end environment of docs/testing.md, "AI tiers in E2E": real weather and
  // real place search, no AI provider at all, so /v1/ai/recommend answers 503 ai_unavailable
  // at once and the app lands on the deterministic three. `createAiProviders` builds a
  // provider per configured model, so two empty lists are the whole switch and the Worker
  // needs no test-only branch. Wrangler does not inherit bindings into a named environment,
  // so the AI, Durable Object and rate-limit bindings are declared again here, and without
  // them the quota-spending routes would answer 503 (see `buildRouter`). The rate-limit
  // namespace ids are the environment's own (a namespace id is an arbitrary per-account
  // integer; distinct ids are distinct counters) and no production id appears in this block.
  // The Durable Object binding names the same class, which is fine because
  // `wrangler dev --env e2e` runs locally.
  "env": {
    "e2e": {
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [{ "name": "DAILY_COUNTERS", "class_name": "DailyCounter" }]
      },
      "ratelimits": [
        { "name": "AI_PROBE_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
        { "name": "AI_RECOMMEND_RATE_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
        { "name": "WEATHER_RATE_LIMIT", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": {
        "OPENROUTER_MODELS": [],
        "WORKERS_AI_MODELS": []
      }
    }
  }
}
