{
  "expo": {
    "name": "kuyara",
    "slug": "kuyara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/kuyara-icon.png",
    "scheme": "kuyara",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ubrn.kuyara",
      "icon": {
        "light": "./assets/icons/kuyara-icon-ios-light.png",
        "dark": "./assets/icons/kuyara-icon-ios-dark.png",
        "tinted": "./assets/icons/kuyara-icon-ios-tinted.png"
      },
      "deploymentTarget": "16.4",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationDefaultAccuracyReduced": true
      }
    },
    "android": {
      "icon": "./assets/icons/kuyara-icon-android-legacy.png",
      "adaptiveIcon": {
        "backgroundColor": "#142F3B",
        "foregroundImage": "./assets/icons/kuyara-icon-android-foreground.png",
        "backgroundImage": "./assets/icons/kuyara-icon-android-background.png",
        "monochromeImage": "./assets/icons/kuyara-icon-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F5",
          "image": "./assets/splash/kuyara-splash-symbol-light.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0D191E",
            "image": "./assets/splash/kuyara-splash-symbol-dark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow kuyara to select a wardrobe photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Allow kuyara to use your approximate location for a one-time weather lookup while you use the app.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      "expo-sqlite",
      ["expo-notifications", { "enableBackgroundRemoteNotifications": false }]
    ],
    "locales": {
      "en": "./src/localization/native/en.json",
      "tr": "./src/localization/native/tr.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2db1d04d-2398-4386-ab05-563cd2d8fb90"
      }
    }
  }
}
