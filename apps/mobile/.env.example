# Optional. The deployed Worker, which serves real weather and the AI route.
# Leave this commented to use the platform-specific local defaults documented in
# README.md, which expect `wrangler dev` on port 8788.
# A physical device can point at the Mac's LAN origin instead, such as
# http://192.168.1.10:8788.
# EXPO_PUBLIC_KUYARA_WORKER_BASE_URL=https://kuyara-worker.ubarin08.workers.dev

# Optional. The PostHog project key. It is a publishable client key, not a secret, but it is
# still never logged and never printed in an error.
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_yourprojectkey

# Required alongside the key: the PostHog ingestion origin, no path. There is no default, so
# the region stays a deliberate choice (https://eu.i.posthog.com or https://us.i.posthog.com).
# Leaving either variable unset keeps product analytics disabled.
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional. The https privacy policy link Settings opens; the app hides the row without it.
# EXPO_PUBLIC_KUYARA_PRIVACY_POLICY_URL=https://example.com/kuyara/privacy
