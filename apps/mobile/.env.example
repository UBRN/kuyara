# Optional. The deployed Worker, which serves real weather and the AI route.
# Leave this commented to use the platform-specific local defaults documented in
# README.md, which expect `wrangler dev` on port 8788.
# A physical device can point at the Mac's LAN origin instead, such as
# http://192.168.1.10:8788.
# EXPO_PUBLIC_KUYARA_WORKER_BASE_URL=https://api.youbrn.com

# Optional. The PostHog project key. It is a publishable client key, not a secret, but it is
# still never logged and never printed in an error.
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_yourprojectkey

# Required alongside the key: the PostHog ingestion origin, no path. There is no default, so
# the region stays a deliberate choice (https://eu.i.posthog.com or https://us.i.posthog.com).
# Leaving either variable unset keeps product analytics disabled.
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional. The Supabase project of the optional accounts (ADR 0041): its https origin and its
# publishable key (`sb_publishable_...`), both public. A local development build uses the
# development project here; production builds take the live project from the EAS production
# environment. Accounts are composed only when both are set; without them the account screens
# fail closed. A secret key is refused.
# EXPO_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_yourkey

# Optional. The public iOS OAuth client id of Sign in with Google (ADR 0041); it is the ID
# token's audience, listed among the Supabase Google provider's client ids. Google sign-in fails
# closed unless it is set.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-youriosclient.apps.googleusercontent.com
